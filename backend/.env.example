# Set DB_ENGINE to sqlite for a quick local demo, or leave PostgreSQL for pgAdmin setup.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=epms
DB_USER=epms_user
DB_PASSWORD=replace-with-your-local-password
DB_HOST=localhost
DB_PORT=5432
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8000
# Optional. The employee helper still answers common HR questions without this.
GEMINI_API_KEY=

# SMTP configuration for password reset email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@yourcompany.com
